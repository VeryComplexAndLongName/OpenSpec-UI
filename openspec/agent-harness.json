{
  "stepAgents": {
    "propose": {
      "agent": "claude-cli-acp",
      "model": "claude-opus-5",
      "effort": "xhigh"
    },
    "review": {
      "agent": "claude-cli-acp",
      "model": "claude-opus-5",
      "effort": "high"
    },
    "apply": {
      "agent": "claude-cli-acp",
      "model": "claude-sonnet-5",
      "effort": "high"
    },
    "verify": {
      "agent": "claude-cli-acp",
      "model": "claude-opus-5",
      "effort": "high"
    }
  },
  "autonomyLevel": "assisted",
  "reviewGate": {
    "mode": "human-required"
  },
  "budget": {
    "maxCostUsd": 15
  },
  "timeout": {
    "maxRunSeconds": 10800,
    "maxStageSeconds": 3600
  }
}
