{
  "name": "@openspec-ui/cli",
  "version": "0.33.0",
  "description": "OpenSpec changes from a terminal and a launcher for the local OpenSpec Workbench.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeryComplexAndLongName/OpenSpec-UI.git",
    "directory": "packages/cli"
  },
  "homepage": "https://openspec-ui.dev",
  "keywords": [
    "openspec",
    "spec-driven",
    "ci",
    "validate"
  ],
  "type": "module",
  "bin": {
    "openspec-ui-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "cheerio": "1.0.0",
    "cross-spawn": "^7.0.6",
    "simple-git": "^4.0.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.30.1",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openspec-ui/core": "*",
    "@openspec-ui/server": "*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  }
}
