{
  "name": "@openspec-ui/cli",
  "version": "0.2.0",
  "description": "Non-interactive OpenSpec change validation for CI merge gates (see docs/adr/0007-ci-cli-third-delivery-target.md).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeryComplexAndLongName/OpenSpec-UI.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "openspec",
    "spec-driven",
    "ci",
    "validate"
  ],
  "type": "module",
  "bin": {
    "openspec-ui-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@openspec-ui/core": "*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "build": "node scripts/build.mjs"
  }
}
