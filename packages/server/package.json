{
  "name": "@openspec-ui/server",
  "private": true,
  "version": "1.13.0",
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@openspec-ui/core": "*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src e2e playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "build": "node scripts/build-client.mjs",
    "start": "tsx src/cli.ts"
  }
}
