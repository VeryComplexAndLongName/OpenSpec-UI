{
  "name": "openspec-ui-vscode",
  "displayName": "OpenSpec Workbench",
  "description": "Native OpenSpec workflow with lifecycle controls, VS Code Chat, persistent processes, checkpoints, and conflict-safe rollback.",
  "publisher": "openspec-ui",
  "version": "0.4.3",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeryComplexAndLongName/OpenSpec-UI.git",
    "directory": "packages/extension"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "openspec",
    "spec-driven",
    "workflow"
  ],
  "type": "commonjs",
  "main": "dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "openspec-ui.status",
        "title": "OpenSpec UI: Status"
      },
      {
        "command": "openspec-ui.initialize",
        "title": "OpenSpec UI: Initialize Workspace"
      },
      {
        "command": "openspec-ui.createChange",
        "title": "OpenSpec UI: Create Change",
        "icon": "$(add)"
      },
      {
        "command": "openspec-ui.validateSelectedChange",
        "title": "OpenSpec UI: Validate Change",
        "icon": "$(pass)"
      },
      {
        "command": "openspec-ui.archiveChange",
        "title": "OpenSpec UI: Archive Change",
        "icon": "$(archive)"
      },
      {
        "command": "openspec-ui.unarchiveChange",
        "title": "OpenSpec UI: Unarchive Change",
        "icon": "$(unarchive)"
      },
      {
        "command": "openspec-ui.deleteChange",
        "title": "OpenSpec UI: Delete Change",
        "icon": "$(trash)"
      },
      {
        "command": "openspec-ui.openspecView",
        "title": "OpenSpec UI: OpenSpec View (CLI)"
      },
      {
        "command": "openspec-ui.showChangeDetails",
        "title": "OpenSpec UI: Show Change Details"
      },
      {
        "command": "openspec-ui.validateChangeStrict",
        "title": "OpenSpec UI: Validate Change (Strict)"
      },
      {
        "command": "openspec-ui.listSpecsSummary",
        "title": "OpenSpec UI: List Specs Summary"
      },
      {
        "command": "openspec-ui.openAiPanel",
        "title": "OpenSpec UI: Open Process Dashboard",
        "icon": "$(pulse)"
      },
      {
        "command": "openspec-ui.refresh",
        "title": "OpenSpec UI: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "openspec-ui.reviewDiff",
        "title": "OpenSpec UI: Review Diff (tasks.md vs HEAD)",
        "icon": "$(diff)"
      },
      {
        "command": "openspec-ui.cancelProcess",
        "title": "OpenSpec UI: Cancel Process",
        "icon": "$(debug-stop)"
      },
      {
        "command": "openspec-ui.startImplementation",
        "title": "OpenSpec UI: Implement with VS Code Agent",
        "icon": "$(sparkle)"
      },
      {
        "command": "openspec-ui.finishImplementation",
        "title": "OpenSpec UI: Finish Implementation & Review",
        "icon": "$(check-all)"
      },
      {
        "command": "openspec-ui.rollbackProcess",
        "title": "OpenSpec UI: Rollback Process Changes",
        "icon": "$(discard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openspec-ui",
          "title": "OpenSpec UI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "openspec-ui": [
        {
          "id": "openspecUiChanges",
          "name": "Changes"
        },
        {
          "id": "openspecUiArchive",
          "name": "Archive"
        },
        {
          "id": "openspecUiSpecs",
          "name": "Specs"
        },
        {
          "id": "openspecUiProcesses",
          "name": "Processes"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "openspec-ui.workbench",
        "name": "openspec",
        "fullName": "OpenSpec Workbench",
        "description": "Plan, implement, review, inspect, and validate OpenSpec changes.",
        "isSticky": true,
        "commands": [
          {
            "name": "plan",
            "description": "Plan an active OpenSpec change"
          },
          {
            "name": "implement",
            "description": "Implement with a checkpointed VS Code Agent session"
          },
          {
            "name": "review",
            "description": "Review implementation readiness and risks"
          },
          {
            "name": "status",
            "description": "Show deterministic OpenSpec status"
          },
          {
            "name": "validate",
            "description": "Run strict OpenSpec validation"
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openspec-ui.createChange",
          "when": "view == openspecUiChanges",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.refresh",
          "when": "view == openspecUiChanges || view == openspecUiArchive || view == openspecUiSpecs",
          "group": "navigation"
        },
        {
          "command": "openspec-ui.openAiPanel",
          "when": "view == openspecUiChanges",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "openspec-ui.reviewDiff",
          "when": "viewItem == openspec-ui.activeChange",
          "group": "inline"
        },
        {
          "command": "openspec-ui.validateSelectedChange",
          "when": "viewItem == openspec-ui.activeChange",
          "group": "inline"
        },
        {
          "command": "openspec-ui.archiveChange",
          "when": "viewItem == openspec-ui.activeChange",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.startImplementation",
          "when": "viewItem == openspec-ui.activeChange",
          "group": "openspec@2"
        },
        {
          "command": "openspec-ui.unarchiveChange",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.deleteChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.archivedChange",
          "group": "openspec@9"
        },
        {
          "command": "openspec-ui.cancelProcess",
          "when": "viewItem == openspec-ui.cancellableProcess || viewItem == openspec-ui.implementationProcess",
          "group": "inline"
        },
        {
          "command": "openspec-ui.finishImplementation",
          "when": "viewItem == openspec-ui.implementationProcess",
          "group": "inline"
        },
        {
          "command": "openspec-ui.rollbackProcess",
          "when": "viewItem == openspec-ui.rollbackableProcess",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "OpenSpec UI",
      "properties": {
        "openspec-ui.transport.localServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run an optional local REST/WS server (same package as the standalone tool) and point the AI panel webview at it instead of the default in-process message bridge."
        }
      }
    }
  },
  "dependencies": {
    "@openspec-ui/core": "*",
    "@openspec-ui/webui": "*",
    "@openspec-ui/server": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0",
    "@types/mocha": "^10.0.10",
    "glob": "^13.0.0",
    "@vscode/vsce": "^3.9.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "test:integration": "node src/test/run.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  }
}