{
  "name": "openspec-ui-vscode",
  "private": true,
  "displayName": "OpenSpec Workbench",
  "description": "A dashboard + VS Code extension for OpenSpec, with Claude, Copilot, Codex, Gemini and DeepSeek agents built in.",
  "publisher": "openspec-ui",
  "version": "0.98.0",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeryComplexAndLongName/OpenSpec-UI.git",
    "directory": "packages/extension"
  },
  "homepage": "https://openspec-ui.dev",
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "openspec",
    "spec-driven-development",
    "ai-agents",
    "coding-agent",
    "workflow"
  ],
  "type": "commonjs",
  "main": "dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "workspaceContains:openspec/changes",
    "workspaceContains:openspec/config.yaml",
    "workspaceContains:openspec/project.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "openspec-ui.showStatus",
        "title": "Show Status",
        "category": "OpenSpec Workbench",
        "icon": "$(pulse)"
      },
      {
        "command": "openspec-ui.initializeWorkspace",
        "title": "Initialize Workspace...",
        "category": "OpenSpec Workbench",
        "icon": "$(rocket)"
      },
      {
        "command": "openspec-ui.writeRules",
        "title": "Write Rules",
        "category": "OpenSpec Workbench",
        "icon": "$(law)"
      },
      {
        "command": "openspec-ui.generateInstructions",
        "title": "Generate Instructions...",
        "category": "OpenSpec Workbench",
        "icon": "$(sparkle)"
      },
      {
        "command": "openspec-ui.initializeWorkspaceHarness",
        "title": "Initialize Workspace Harness...",
        "category": "OpenSpec Workbench",
        "icon": "$(tools)"
      },
      {
        "command": "openspec-ui.configureDependabot",
        "title": "Configure Dependabot...",
        "category": "OpenSpec Workbench",
        "icon": "$(shield)"
      },
      {
        "command": "openspec-ui.generateScopedInstructions",
        "title": "Generate Scoped Instructions...",
        "category": "OpenSpec Workbench",
        "icon": "$(wand)"
      },
      {
        "command": "openspec-ui.configureWorkspaceHarness",
        "title": "Configure Workspace Harness",
        "category": "OpenSpec Workbench",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openspec-ui.setLlmKey",
        "title": "Set LLM Key...",
        "category": "OpenSpec Workbench",
        "icon": "$(key)"
      },
      {
        "command": "openspec-ui.configureChangeHarness",
        "title": "Configure Change Harness",
        "category": "OpenSpec Workbench",
        "icon": "$(gear)"
      },
      {
        "command": "openspec-ui.runChange",
        "title": "Run Change...",
        "category": "OpenSpec Workbench",
        "icon": "$(play)"
      },
      {
        "command": "openspec-ui.createChange",
        "title": "Create Change...",
        "icon": "$(add)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.createTemplate",
        "title": "Create Template...",
        "category": "OpenSpec Workbench",
        "icon": "$(new-file)"
      },
      {
        "command": "openspec-ui.validateChange",
        "title": "Validate Change",
        "icon": "$(checklist)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.showTimeline",
        "title": "Show Timeline",
        "icon": "$(history)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.showAncestry",
        "title": "Show Ancestry",
        "icon": "$(type-hierarchy-super)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.showCost",
        "title": "Show Cost",
        "icon": "$(credit-card)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.explainChangeHarness",
        "title": "Explain Change Harness",
        "icon": "$(info)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.recommendChangeHarness",
        "title": "Recommend Change Harness",
        "icon": "$(lightbulb)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.showGraph",
        "title": "Show Graph",
        "icon": "$(graph)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.showChange",
        "title": "Show Change",
        "icon": "$(preview)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.openPipeline",
        "title": "Open Pipeline",
        "icon": "$(type-hierarchy)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.archiveChange",
        "title": "Archive Change",
        "icon": "$(archive)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.openChangeCopy",
        "title": "Open Change Copy...",
        "icon": "$(files)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.openWorktree",
        "title": "Open Worktree",
        "icon": "$(folder-opened)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.findChange",
        "title": "Find Change...",
        "icon": "$(search)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.restoreChange",
        "title": "Restore Change",
        "icon": "$(discard)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.copyTasks",
        "title": "Copy Tasks...",
        "icon": "$(copy)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.editTemplate",
        "title": "Edit Template",
        "icon": "$(edit)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.insertTemplate",
        "title": "Insert Template...",
        "icon": "$(insert)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.deleteTemplate",
        "title": "Delete Template",
        "icon": "$(circle-slash)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.deleteChange",
        "title": "Delete Change",
        "icon": "$(trash)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.deleteTask",
        "title": "Delete Task",
        "icon": "$(close)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.runItem",
        "title": "Run Item",
        "icon": "$(run-all)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.confirmKey",
        "title": "Confirm Key...",
        "icon": "$(pass)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.answerQuestion",
        "title": "Answer Question...",
        "icon": "$(reply)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.joinTeam",
        "title": "Join Team...",
        "category": "OpenSpec Workbench",
        "icon": "$(person-add)"
      },
      {
        "command": "openspec-ui.openCliView",
        "title": "Open CLI View",
        "category": "OpenSpec Workbench",
        "icon": "$(terminal)"
      },
      {
        "command": "openspec-ui.showComparison",
        "title": "Show Comparison",
        "category": "OpenSpec Workbench",
        "icon": "$(git-compare)"
      },
      {
        "command": "openspec-ui.generateReport",
        "title": "Generate Report...",
        "category": "OpenSpec Workbench",
        "icon": "$(report)"
      },
      {
        "command": "openspec-ui.showDetails",
        "title": "Show Details",
        "category": "OpenSpec Workbench",
        "icon": "$(note)"
      },
      {
        "command": "openspec-ui.showSpecs",
        "title": "Show Specs",
        "category": "OpenSpec Workbench",
        "icon": "$(book)"
      },
      {
        "command": "openspec-ui.openDashboard",
        "title": "Open Dashboard",
        "icon": "$(dashboard)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.refreshViews",
        "title": "Refresh Views",
        "icon": "$(refresh)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.deleteLeftover",
        "title": "Delete Leftover",
        "icon": "$(diff-removed)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.deleteWorktree",
        "title": "Delete Worktree",
        "icon": "$(repo-delete)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.sendMessage",
        "title": "Send Message...",
        "icon": "$(comment)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.stopRun",
        "title": "Stop Run...",
        "icon": "$(debug-stop)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.addRelation",
        "title": "Add Relation...",
        "icon": "$(link)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.removeRelation",
        "title": "Remove Relation...",
        "icon": "$(debug-disconnect)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.filterArchive",
        "title": "Filter Archive...",
        "icon": "$(filter)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.clearArchiveFilter",
        "title": "Clear Archive Filter",
        "icon": "$(clear-all)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.filterSpecs",
        "title": "Filter Specs...",
        "icon": "$(list-filter)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.clearSpecsFilter",
        "title": "Clear Specs Filter",
        "icon": "$(close-all)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.filterGraph",
        "title": "Filter Graph...",
        "icon": "$(filter-filled)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.clearGraphFilter",
        "title": "Clear Graph Filter",
        "icon": "$(search-stop)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.showRelations",
        "title": "Show Relations",
        "icon": "$(eye)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.hideRelations",
        "title": "Hide Relations",
        "icon": "$(eye-closed)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.showDiff",
        "title": "Show Diff",
        "icon": "$(diff)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.stopProcess",
        "title": "Stop Process",
        "icon": "$(stop-circle)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.finishImplementation",
        "title": "Finish Implementation",
        "icon": "$(check-all)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.rollbackProcess",
        "title": "Rollback Process",
        "icon": "$(debug-step-back)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.rollbackChange",
        "title": "Rollback Change",
        "icon": "$(debug-reverse-continue)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.runTypecheck",
        "title": "Run Typecheck",
        "icon": "$(check)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.runTests",
        "title": "Run Tests",
        "icon": "$(beaker)",
        "category": "OpenSpec Workbench"
      },
      {
        "command": "openspec-ui.runLint",
        "title": "Run Lint",
        "icon": "$(symbol-ruler)",
        "category": "OpenSpec Workbench"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openspec-ui",
          "title": "OpenSpec Workbench",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "openspec-ui": [
        {
          "id": "openspecUiChanges",
          "name": "Changes"
        },
        {
          "id": "openspecUiArchive",
          "name": "Archive"
        },
        {
          "id": "openspecUiSpecs",
          "name": "Specs"
        },
        {
          "id": "openspecUiProcesses",
          "name": "Processes"
        },
        {
          "id": "openspecUiTemplates",
          "name": "Templates"
        },
        {
          "id": "openspecUiChangeGraph",
          "name": "Change Graph"
        },
        {
          "id": "openspecUiHumanOnlyInbox",
          "name": "Human-Only Inbox"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "openspec-ui.workbench",
        "name": "openspec",
        "fullName": "OpenSpec Workbench",
        "description": "Plan, implement, review, inspect, and validate OpenSpec changes.",
        "isSticky": true,
        "commands": [
          {
            "name": "plan",
            "description": "Plan an active OpenSpec change"
          },
          {
            "name": "implement",
            "description": "Implement with a checkpointed VS Code Agent session"
          },
          {
            "name": "review",
            "description": "Review implementation readiness and risks"
          },
          {
            "name": "status",
            "description": "Show deterministic OpenSpec status"
          },
          {
            "name": "validate",
            "description": "Run strict OpenSpec validation"
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openspec-ui.findChange",
          "when": "view == openspecUiChanges",
          "group": "navigation@0"
        },
        {
          "command": "openspec-ui.filterArchive",
          "when": "view == openspecUiArchive",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.clearArchiveFilter",
          "when": "view == openspecUiArchive && openspec-ui.archiveFiltered",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.filterSpecs",
          "when": "view == openspecUiSpecs",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.clearSpecsFilter",
          "when": "view == openspecUiSpecs && openspec-ui.specsFiltered",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.filterGraph",
          "when": "view == openspecUiChangeGraph",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.clearGraphFilter",
          "when": "view == openspecUiChangeGraph && openspec-ui.changeGraphFiltered",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.showRelations",
          "when": "view == openspecUiChangeGraph && !openspec-ui.landedRelationsShown",
          "group": "navigation@3"
        },
        {
          "command": "openspec-ui.hideRelations",
          "when": "view == openspecUiChangeGraph && openspec-ui.landedRelationsShown",
          "group": "navigation@3"
        },
        {
          "command": "openspec-ui.createChange",
          "when": "view == openspecUiChanges",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.createTemplate",
          "when": "view == openspecUiChanges"
        },
        {
          "command": "openspec-ui.refreshViews",
          "when": "view == openspecUiChanges || view == openspecUiArchive || view == openspecUiSpecs || view == openspecUiTemplates || view == openspecUiChangeGraph || view == openspecUiHumanOnlyInbox",
          "group": "navigation"
        },
        {
          "command": "openspec-ui.openDashboard",
          "when": "view == openspecUiChanges",
          "group": "navigation"
        },
        {
          "command": "openspec-ui.openPipeline",
          "when": "view == openspecUiChanges",
          "group": "navigation"
        },
        {
          "command": "openspec-ui.runTypecheck",
          "when": "view == openspecUiChanges && openspec-ui.checks.typecheck",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.runTests",
          "when": "view == openspecUiChanges && openspec-ui.checks.test",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.runLint",
          "when": "view == openspecUiChanges && openspec-ui.checks.lint",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.showComparison",
          "when": "view == openspecUiChanges"
        }
      ],
      "view/item/context": [
        {
          "command": "openspec-ui.deleteLeftover",
          "when": "viewItem == openspec-ui.leftover || viewItem == openspec-ui.unwrittenChange || viewItem == openspec-ui.unwrittenChange.related",
          "group": "inline"
        },
        {
          "command": "openspec-ui.deleteLeftover",
          "when": "viewItem == openspec-ui.leftover || viewItem == openspec-ui.unwrittenChange || viewItem == openspec-ui.unwrittenChange.related",
          "group": "leftover@1"
        },
        {
          "command": "openspec-ui.sendMessage",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.graphActiveChange || viewItem == openspec-ui.graphActiveChange.related || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "relation@3"
        },
        {
          "command": "openspec-ui.stopRun",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.graphActiveChange || viewItem == openspec-ui.graphActiveChange.related || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "relation@3"
        },
        {
          "command": "openspec-ui.addRelation",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.graphActiveChange || viewItem == openspec-ui.graphActiveChange.related || viewItem == openspec-ui.unwrittenChange || viewItem == openspec-ui.unwrittenChange.related",
          "group": "relation@1"
        },
        {
          "command": "openspec-ui.removeRelation",
          "when": "viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.graphActiveChange.related || viewItem == openspec-ui.unwrittenChange.related",
          "group": "relation@2"
        },
        {
          "command": "openspec-ui.showDiff",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "inline"
        },
        {
          "command": "openspec-ui.validateChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "inline"
        },
        {
          "command": "openspec-ui.openChangeCopy",
          "when": "viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.openWorktree",
          "when": "viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@2"
        },
        {
          "command": "openspec-ui.archiveChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.restoreChange",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.copyTasks",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@2"
        },
        {
          "command": "openspec-ui.rollbackChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.archivedChange",
          "group": "openspec@3"
        },
        {
          "command": "openspec-ui.showTimeline",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@4"
        },
        {
          "command": "openspec-ui.showAncestry",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@5"
        },
        {
          "command": "openspec-ui.showCost",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@6"
        },
        {
          "command": "openspec-ui.explainChangeHarness",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@7"
        },
        {
          "command": "openspec-ui.recommendChangeHarness",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@8"
        },
        {
          "command": "openspec-ui.showGraph",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@5"
        },
        {
          "command": "openspec-ui.showChange",
          "when": "viewItem == openspec-ui.graphActiveChange || viewItem == openspec-ui.graphActiveChange.related || viewItem == openspec-ui.graphArchivedChange",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.configureChangeHarness",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related",
          "group": "openspec@5"
        },
        {
          "command": "openspec-ui.runChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related",
          "group": "openspec@6"
        },
        {
          "command": "openspec-ui.editTemplate",
          "when": "viewItem == openspec-ui.builtInTemplate",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.insertTemplate",
          "when": "viewItem == openspec-ui.builtInTemplate || viewItem == openspec-ui.projectTemplate",
          "group": "openspec@2"
        },
        {
          "command": "openspec-ui.deleteTemplate",
          "when": "viewItem == openspec-ui.projectTemplate",
          "group": "openspec@9"
        },
        {
          "command": "openspec-ui.deleteChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.related || viewItem == openspec-ui.archivedChange",
          "group": "openspec@9"
        },
        {
          "command": "openspec-ui.deleteTask",
          "when": "viewItem == openspec-ui.activeTask",
          "group": "openspec@9"
        },
        {
          "command": "openspec-ui.runItem",
          "when": "viewItem == openspec-ui.humanOnlyInboxItem.agent",
          "group": "inline"
        },
        {
          "command": "openspec-ui.confirmKey",
          "when": "viewItem == openspec-ui.enrolmentRequest",
          "group": "inline"
        },
        {
          "command": "openspec-ui.answerQuestion",
          "when": "viewItem == openspec-ui.operatorQuestion",
          "group": "inline"
        },
        {
          "command": "openspec-ui.stopProcess",
          "when": "viewItem == openspec-ui.cancellableProcess || viewItem == openspec-ui.implementationProcess",
          "group": "inline"
        },
        {
          "command": "openspec-ui.finishImplementation",
          "when": "viewItem == openspec-ui.implementationProcess",
          "group": "inline"
        },
        {
          "command": "openspec-ui.rollbackProcess",
          "when": "viewItem == openspec-ui.rollbackableProcess",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "openspec-ui.runTypecheck",
          "when": "openspec-ui.checks.typecheck"
        },
        {
          "command": "openspec-ui.runTests",
          "when": "openspec-ui.checks.test"
        },
        {
          "command": "openspec-ui.runLint",
          "when": "openspec-ui.checks.lint"
        }
      ]
    },
    "configuration": {
      "title": "OpenSpec Workbench",
      "properties": {
        "openspec-ui.transport.localServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run an optional local REST/WS server (same package as the standalone tool) and point the AI panel and Pipeline panel webviews at it instead of the default in-process message bridge. With this on, the Pipeline panel's readings come from the server's own process, so its cards keep answering while a harness chain runs in this editor."
        },
        "openspec-ui.checkpointRetentionDays": {
          "type": "number",
          "default": 0,
          "description": "Days to keep process/checkpoint history before it's pruned on the next window reload. 0 or a negative number keeps everything forever (the default, unchanged from prior versions). WARNING: once a process is pruned, Rollback (both single-process and whole-Change) is permanently unavailable for it — pruning is not itself reversible."
        },
        "openspec-ui.staleTaskThresholdDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "description": "Days a pending task can sit untouched (per git blame on tasks.md) before the Change Timeline view flags it as stale."
        },
        "openspec-ui.localLlm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Where the local LLM (agent local-llm) answers: an OpenAI-compatible server's base URL, with its /v1 or without, such as http://192.168.1.10:8000/v1. Empty means the environment variable OPENSPEC_UI_LOCAL_LLM_BASE_URL, and then http://localhost:30000. Its API key is set with \"OpenSpec Workbench: Set Local LLM API Key...\" and kept in the editor's secret storage, never here. Read when the window opens."
        },
        "openspec-ui.localLlm.model": {
          "type": "string",
          "default": "",
          "description": "The model the local LLM agents (local-llm and local-llm-acp) ask for, as the server names it, such as QuantTrio/Qwen3.6-35B-A3B-AWQ. Optional: a stage's own model wins over it, and where neither names one the server is asked which model it serves (its /v1/models). Empty means the environment variable OPENSPEC_UI_LOCAL_LLM_MODEL, then the server. Read when the window opens."
        },
        "openspec-ui.localLlm.agent.askBeforeCommands": {
          "type": "boolean",
          "default": false,
          "description": "The built-in local LLM agent (local-llm-acp) asks before each command it runs, and runs it only if you allow it. Off: commands run without asking, as the other agents' do, inside the change's working directory and within their time limit. Leave it off for a chain that runs unattended: nobody would answer. Same as OPENSPEC_UI_LOCAL_LLM_ASK_BEFORE_COMMANDS=1. Read when the window opens."
        },
        "openspec-ui.agents.ignoreSystemProxy": {
          "type": "boolean",
          "default": false,
          "description": "Agents ignore the system proxy. The local LLM agents (local-llm, local-llm-acp) and their availability check connect directly, whatever proxy the editor applies; a CLI agent is started with HTTP_PROXY, HTTPS_PROXY and ALL_PROXY removed and NO_PROXY=*, which only a CLI that reads those variables honours (see HARNESS.md). Turn it on when the proxy cannot reach your model, such as a server on your LAN. Same as OPENSPEC_UI_IGNORE_SYSTEM_PROXY=1. Read when the window opens."
        },
        "openspec-ui.followSelectionInChangeGraph": {
          "type": "boolean",
          "default": false,
          "description": "When on, selecting a change in Changes or Archive reveals it in the Change Graph automatically. Off by default: the graph shows only changes that state a relation (follows/supersedes/blocked_by), so for most changes there is nothing to reveal — use \"OpenSpec Workbench: Reveal in Change Graph\" on demand instead."
        },
        "openspec-ui.checks": {
          "type": "object",
          "default": {},
          "description": "Names which npm script each check (\"typecheck\", \"test\", \"lint\") runs when invoked from the editor. Unset, the extension prefers an \"osui-<name>\" script when this workspace's package.json declares one, then falls back to \"<name>\"; a workspace declaring neither is offered no command for that check at all, rather than one that fails.",
          "properties": {
            "typecheck": {
              "type": "string",
              "description": "npm script to run for the Typecheck command."
            },
            "test": {
              "type": "string",
              "description": "npm script to run for the Run Tests command."
            },
            "lint": {
              "type": "string",
              "description": "npm script to run for the Run Lint command."
            }
          },
          "additionalProperties": false
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "openspec/templates/*/template.json",
        "url": "./schemas/template.schema.json"
      },
      {
        "fileMatch": "openspec/agent-harness.json",
        "url": "./schemas/agent-harness.schema.json"
      },
      {
        "fileMatch": "openspec/changes/*/harness.json",
        "url": "./schemas/change-harness.schema.json"
      }
    ]
  },
  "dependencies": {
    "@openspec-ui/core": "*",
    "@openspec-ui/webui": "*",
    "@openspec-ui/server": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0",
    "@types/mocha": "^10.0.10",
    "glob": "^13.0.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^6.15.0",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "test:integration": "node src/test/run.mjs",
    "test:pictures": "npm run build && playwright test",
    "package": "npm run build && vsce package --no-dependencies",
    "reinstall:local": "node scripts/reinstall-local.mjs",
    "schemas": "tsx scripts/write-harness-schemas.mts"
  }
}
