{
  "name": "openspec-ui-vscode",
  "private": true,
  "displayName": "OpenSpec Workbench",
  "description": "A dashboard + VS Code extension for OpenSpec, with Claude, Copilot, Codex, and Gemini agents built in.",
  "publisher": "openspec-ui",
  "version": "0.74.2",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeryComplexAndLongName/OpenSpec-UI.git",
    "directory": "packages/extension"
  },
  "homepage": "https://openspec-ui.dev",
  "categories": [
    "Other"
  ],
  "keywords": [
    "openspec",
    "spec-driven",
    "workflow"
  ],
  "type": "commonjs",
  "main": "dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "openspec-ui.status",
        "title": "OpenSpec Workbench: Status"
      },
      {
        "command": "openspec-ui.initialize",
        "title": "OpenSpec Workbench: Initialize Workspace"
      },
      {
        "command": "openspec-ui.generateAgentInstructions",
        "title": "OpenSpec Workbench: Generate Agent Instructions (CLAUDE.md / AGENTS.md)"
      },
      {
        "command": "openspec-ui.setUpAgenticHarness",
        "title": "OpenSpec Workbench: Set Up Agentic Harness"
      },
      {
        "command": "openspec-ui.configureDependabot",
        "title": "OpenSpec Workbench: Configure Dependabot"
      },
      {
        "command": "openspec-ui.generateSubtypeInstructions",
        "title": "OpenSpec Workbench: Generate Path-Scoped Copilot Instructions"
      },
      {
        "command": "openspec-ui.configureHarness",
        "title": "OpenSpec Workbench: Configure Harness Settings"
      },
      {
        "command": "openspec-ui.configureHarnessForChange",
        "title": "OpenSpec Workbench: Configure Harness for this Change"
      },
      {
        "command": "openspec-ui.runWithHarness",
        "title": "OpenSpec Workbench: Run"
      },
      {
        "command": "openspec-ui.createChange",
        "title": "OpenSpec Workbench: Create Change",
        "icon": "$(add)"
      },
      {
        "command": "openspec-ui.createChangeTemplate",
        "title": "OpenSpec Workbench: Create Change Template"
      },
      {
        "command": "openspec-ui.validateSelectedChange",
        "title": "OpenSpec Workbench: Validate Change",
        "icon": "$(pass)"
      },
      {
        "command": "openspec-ui.showChangeTimeline",
        "title": "OpenSpec Workbench: Show Change Timeline",
        "icon": "$(graph-line)"
      },
      {
        "command": "openspec-ui.showChangeAncestry",
        "title": "OpenSpec Workbench: Show What This Change Follows",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "openspec-ui.showChangeCostReport",
        "title": "OpenSpec Workbench: Show What This Change Cost",
        "icon": "$(graph)"
      },
      {
        "command": "openspec-ui.explainHarnessSettings",
        "title": "OpenSpec Workbench: Explain Harness Settings",
        "icon": "$(question)"
      },
      {
        "command": "openspec-ui.recommendHarnessTemplate",
        "title": "OpenSpec Workbench: Recommend a Harness Configuration",
        "icon": "$(lightbulb)"
      },
      {
        "command": "openspec-ui.revealInChangeGraph",
        "title": "OpenSpec Workbench: Reveal in Change Graph",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "openspec-ui.revealInChanges",
        "title": "OpenSpec Workbench: Reveal in Changes",
        "icon": "$(list-tree)"
      },
      {
        "command": "openspec-ui.openPipeline",
        "title": "OpenSpec Workbench: Open Pipeline",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "openspec-ui.archiveChange",
        "title": "OpenSpec Workbench: Archive Change",
        "icon": "$(archive)"
      },
      {
        "command": "openspec-ui.readChangeElsewhere",
        "title": "OpenSpec Workbench: Read This Change As That Directory Has It",
        "icon": "$(book)"
      },
      {
        "command": "openspec-ui.openChangeDirectory",
        "title": "OpenSpec Workbench: Open The Working Directory This Change Is Worked In",
        "icon": "$(folder-opened)"
      },
      {
        "command": "openspec-ui.pickChange",
        "title": "OpenSpec Workbench: Pick A Change, And See Where Each Is Worked",
        "icon": "$(list-selection)"
      },
      {
        "command": "openspec-ui.unarchiveChange",
        "title": "OpenSpec Workbench: Unarchive Change",
        "icon": "$(unarchive)"
      },
      {
        "command": "openspec-ui.copyTasksAsTemplate",
        "title": "OpenSpec Workbench: Copy Tasks as Template Into…",
        "icon": "$(copy)"
      },
      {
        "command": "openspec-ui.customizeTemplate",
        "title": "OpenSpec Workbench: Customize Template",
        "icon": "$(edit)"
      },
      {
        "command": "openspec-ui.insertTemplateIntoChange",
        "title": "OpenSpec Workbench: Insert Template Into…",
        "icon": "$(add)"
      },
      {
        "command": "openspec-ui.deleteProjectTemplate",
        "title": "OpenSpec Workbench: Delete Project Template",
        "icon": "$(trash)"
      },
      {
        "command": "openspec-ui.deleteChange",
        "title": "OpenSpec Workbench: Delete Change",
        "icon": "$(trash)"
      },
      {
        "command": "openspec-ui.deleteTask",
        "title": "OpenSpec Workbench: Delete Task",
        "icon": "$(trash)"
      },
      {
        "command": "openspec-ui.runDelegatedItem",
        "title": "OpenSpec Workbench: Run This Delegated Item",
        "icon": "$(play)"
      },
      {
        "command": "openspec-ui.confirmEnrolment",
        "title": "OpenSpec Workbench: It Was Me",
        "icon": "$(pass)"
      },
      {
        "command": "openspec-ui.openspecView",
        "title": "OpenSpec Workbench: OpenSpec View (CLI)"
      },
      {
        "command": "openspec-ui.showAllChangesTimeline",
        "title": "OpenSpec Workbench: Show Change Comparison Timeline"
      },
      {
        "command": "openspec-ui.generateSprintReport",
        "title": "OpenSpec Workbench: Generate Sprint Report"
      },
      {
        "command": "openspec-ui.showChangeDetails",
        "title": "OpenSpec Workbench: Show Change Details"
      },
      {
        "command": "openspec-ui.validateChangeStrict",
        "title": "OpenSpec Workbench: Validate Change (Strict)"
      },
      {
        "command": "openspec-ui.listSpecsSummary",
        "title": "OpenSpec Workbench: List Specs Summary"
      },
      {
        "command": "openspec-ui.openAiPanel",
        "title": "OpenSpec Workbench: Open Process Dashboard",
        "icon": "$(pulse)"
      },
      {
        "command": "openspec-ui.refresh",
        "title": "OpenSpec Workbench: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "openspec-ui.removeLeftover",
        "title": "OpenSpec Workbench: Remove This Leftover Directory",
        "icon": "$(trash)"
      },
      {
        "command": "openspec-ui.removeWorkingDirectory",
        "title": "OpenSpec Workbench: Remove This Working Directory",
        "icon": "$(trash)"
      },
      {
        "command": "openspec-ui.sayToRun",
        "title": "OpenSpec Workbench: Say Something to This Run",
        "icon": "$(comment)"
      },
      {
        "command": "openspec-ui.stopRunAfterTask",
        "title": "OpenSpec Workbench: Stop This Run After a Task",
        "icon": "$(debug-pause)"
      },
      {
        "command": "openspec-ui.addRelation",
        "title": "OpenSpec Workbench: Add Relation",
        "icon": "$(link)"
      },
      {
        "command": "openspec-ui.removeRelation",
        "title": "OpenSpec Workbench: Remove Relation",
        "icon": "$(link-external)"
      },
      {
        "command": "openspec-ui.filterArchive",
        "title": "OpenSpec Workbench: Filter Archive",
        "icon": "$(search)"
      },
      {
        "command": "openspec-ui.clearArchiveFilter",
        "title": "OpenSpec Workbench: Clear Archive Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "openspec-ui.filterSpecs",
        "title": "OpenSpec Workbench: Filter Specs",
        "icon": "$(search)"
      },
      {
        "command": "openspec-ui.clearSpecsFilter",
        "title": "OpenSpec Workbench: Clear Specs Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "openspec-ui.filterChangeGraph",
        "title": "OpenSpec Workbench: Filter Change Graph",
        "icon": "$(search)"
      },
      {
        "command": "openspec-ui.clearChangeGraphFilter",
        "title": "OpenSpec Workbench: Clear Change Graph Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "openspec-ui.showLandedRelations",
        "title": "OpenSpec Workbench: Show Landed Relations",
        "icon": "$(unfold)"
      },
      {
        "command": "openspec-ui.hideLandedRelations",
        "title": "OpenSpec Workbench: Hide Landed Relations",
        "icon": "$(fold)"
      },
      {
        "command": "openspec-ui.reviewDiff",
        "title": "OpenSpec Workbench: Review Diff (tasks.md vs HEAD)",
        "icon": "$(diff)"
      },
      {
        "command": "openspec-ui.cancelProcess",
        "title": "OpenSpec Workbench: Cancel Process",
        "icon": "$(debug-stop)"
      },
      {
        "command": "openspec-ui.finishImplementation",
        "title": "OpenSpec Workbench: Finish Implementation & Review",
        "icon": "$(check-all)"
      },
      {
        "command": "openspec-ui.rollbackProcess",
        "title": "OpenSpec Workbench: Rollback Process Changes",
        "icon": "$(discard)"
      },
      {
        "command": "openspec-ui.rollbackChange",
        "title": "OpenSpec Workbench: Rollback Change",
        "icon": "$(discard)"
      },
      {
        "command": "openspec-ui.runTypecheck",
        "title": "OpenSpec Workbench: Run Typecheck",
        "icon": "$(check)"
      },
      {
        "command": "openspec-ui.runTest",
        "title": "OpenSpec Workbench: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "openspec-ui.runLint",
        "title": "OpenSpec Workbench: Run Lint",
        "icon": "$(law)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openspec-ui",
          "title": "OpenSpec Workbench",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "openspec-ui": [
        {
          "id": "openspecUiChanges",
          "name": "Changes"
        },
        {
          "id": "openspecUiArchive",
          "name": "Archive"
        },
        {
          "id": "openspecUiSpecs",
          "name": "Specs"
        },
        {
          "id": "openspecUiProcesses",
          "name": "Processes"
        },
        {
          "id": "openspecUiTemplates",
          "name": "Templates"
        },
        {
          "id": "openspecUiChangeGraph",
          "name": "Change Graph"
        },
        {
          "id": "openspecUiHumanOnlyInbox",
          "name": "Human-Only Inbox"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "openspec-ui.workbench",
        "name": "openspec",
        "fullName": "OpenSpec Workbench",
        "description": "Plan, implement, review, inspect, and validate OpenSpec changes.",
        "isSticky": true,
        "commands": [
          {
            "name": "plan",
            "description": "Plan an active OpenSpec change"
          },
          {
            "name": "implement",
            "description": "Implement with a checkpointed VS Code Agent session"
          },
          {
            "name": "review",
            "description": "Review implementation readiness and risks"
          },
          {
            "name": "status",
            "description": "Show deterministic OpenSpec status"
          },
          {
            "name": "validate",
            "description": "Run strict OpenSpec validation"
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openspec-ui.pickChange",
          "when": "view == openspecUiChanges",
          "group": "navigation@0"
        },
        {
          "command": "openspec-ui.filterArchive",
          "when": "view == openspecUiArchive",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.clearArchiveFilter",
          "when": "view == openspecUiArchive && openspec-ui.archiveFiltered",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.filterSpecs",
          "when": "view == openspecUiSpecs",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.clearSpecsFilter",
          "when": "view == openspecUiSpecs && openspec-ui.specsFiltered",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.filterChangeGraph",
          "when": "view == openspecUiChangeGraph",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.clearChangeGraphFilter",
          "when": "view == openspecUiChangeGraph && openspec-ui.changeGraphFiltered",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.showLandedRelations",
          "when": "view == openspecUiChangeGraph && !openspec-ui.landedRelationsShown",
          "group": "navigation@3"
        },
        {
          "command": "openspec-ui.hideLandedRelations",
          "when": "view == openspecUiChangeGraph && openspec-ui.landedRelationsShown",
          "group": "navigation@3"
        },
        {
          "command": "openspec-ui.createChange",
          "when": "view == openspecUiChanges",
          "group": "navigation@1"
        },
        {
          "command": "openspec-ui.createChangeTemplate",
          "when": "view == openspecUiChanges"
        },
        {
          "command": "openspec-ui.refresh",
          "when": "view == openspecUiChanges || view == openspecUiArchive || view == openspecUiSpecs || view == openspecUiTemplates || view == openspecUiChangeGraph || view == openspecUiHumanOnlyInbox",
          "group": "navigation"
        },
        {
          "command": "openspec-ui.openAiPanel",
          "when": "view == openspecUiChanges",
          "group": "navigation"
        },
        {
          "command": "openspec-ui.openPipeline",
          "when": "view == openspecUiChanges",
          "group": "navigation"
        },
        {
          "command": "openspec-ui.runTypecheck",
          "when": "view == openspecUiChanges && openspec-ui.checks.typecheck",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.runTest",
          "when": "view == openspecUiChanges && openspec-ui.checks.test",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.runLint",
          "when": "view == openspecUiChanges && openspec-ui.checks.lint",
          "group": "navigation@2"
        },
        {
          "command": "openspec-ui.showAllChangesTimeline",
          "when": "view == openspecUiChanges"
        }
      ],
      "view/item/context": [
        {
          "command": "openspec-ui.removeLeftover",
          "when": "viewItem == openspec-ui.leftover",
          "group": "inline"
        },
        {
          "command": "openspec-ui.sayToRun",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.graphActiveChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "relation@3"
        },
        {
          "command": "openspec-ui.stopRunAfterTask",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.graphActiveChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "relation@3"
        },
        {
          "command": "openspec-ui.addRelation",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.graphActiveChange",
          "group": "relation@1"
        },
        {
          "command": "openspec-ui.removeRelation",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.graphActiveChange",
          "group": "relation@2"
        },
        {
          "command": "openspec-ui.reviewDiff",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "inline"
        },
        {
          "command": "openspec-ui.validateSelectedChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "inline"
        },
        {
          "command": "openspec-ui.readChangeElsewhere",
          "when": "viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.openChangeDirectory",
          "when": "viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@2"
        },
        {
          "command": "openspec-ui.archiveChange",
          "when": "viewItem == openspec-ui.activeChange",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.unarchiveChange",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.copyTasksAsTemplate",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@2"
        },
        {
          "command": "openspec-ui.rollbackChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.archivedChange",
          "group": "openspec@3"
        },
        {
          "command": "openspec-ui.showChangeTimeline",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@4"
        },
        {
          "command": "openspec-ui.showChangeAncestry",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@5"
        },
        {
          "command": "openspec-ui.showChangeCostReport",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@6"
        },
        {
          "command": "openspec-ui.explainHarnessSettings",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@7"
        },
        {
          "command": "openspec-ui.recommendHarnessTemplate",
          "when": "viewItem == openspec-ui.archivedChange",
          "group": "openspec@8"
        },
        {
          "command": "openspec-ui.revealInChangeGraph",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.archivedChange || viewItem == openspec-ui.activeChange.elsewhere",
          "group": "openspec@5"
        },
        {
          "command": "openspec-ui.revealInChanges",
          "when": "viewItem == openspec-ui.graphActiveChange || viewItem == openspec-ui.graphArchivedChange",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.configureHarnessForChange",
          "when": "viewItem == openspec-ui.activeChange",
          "group": "openspec@5"
        },
        {
          "command": "openspec-ui.runWithHarness",
          "when": "viewItem == openspec-ui.activeChange",
          "group": "openspec@6"
        },
        {
          "command": "openspec-ui.customizeTemplate",
          "when": "viewItem == openspec-ui.builtInTemplate",
          "group": "openspec@1"
        },
        {
          "command": "openspec-ui.insertTemplateIntoChange",
          "when": "viewItem == openspec-ui.builtInTemplate || viewItem == openspec-ui.projectTemplate",
          "group": "openspec@2"
        },
        {
          "command": "openspec-ui.deleteProjectTemplate",
          "when": "viewItem == openspec-ui.projectTemplate",
          "group": "openspec@9"
        },
        {
          "command": "openspec-ui.deleteChange",
          "when": "viewItem == openspec-ui.activeChange || viewItem == openspec-ui.archivedChange",
          "group": "openspec@9"
        },
        {
          "command": "openspec-ui.deleteTask",
          "when": "viewItem == openspec-ui.activeTask",
          "group": "openspec@9"
        },
        {
          "command": "openspec-ui.runDelegatedItem",
          "when": "viewItem == openspec-ui.humanOnlyInboxItem.agent",
          "group": "inline"
        },
        {
          "command": "openspec-ui.confirmEnrolment",
          "when": "viewItem == openspec-ui.enrolmentRequest",
          "group": "inline"
        },
        {
          "command": "openspec-ui.cancelProcess",
          "when": "viewItem == openspec-ui.cancellableProcess || viewItem == openspec-ui.implementationProcess",
          "group": "inline"
        },
        {
          "command": "openspec-ui.finishImplementation",
          "when": "viewItem == openspec-ui.implementationProcess",
          "group": "inline"
        },
        {
          "command": "openspec-ui.rollbackProcess",
          "when": "viewItem == openspec-ui.rollbackableProcess",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "openspec-ui.runTypecheck",
          "when": "openspec-ui.checks.typecheck"
        },
        {
          "command": "openspec-ui.runTest",
          "when": "openspec-ui.checks.test"
        },
        {
          "command": "openspec-ui.runLint",
          "when": "openspec-ui.checks.lint"
        }
      ]
    },
    "configuration": {
      "title": "OpenSpec Workbench",
      "properties": {
        "openspec-ui.transport.localServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run an optional local REST/WS server (same package as the standalone tool) and point the AI panel and Pipeline panel webviews at it instead of the default in-process message bridge. With this on, the Pipeline panel's readings come from the server's own process, so its cards keep answering while a harness chain runs in this editor."
        },
        "openspec-ui.checkpointRetentionDays": {
          "type": "number",
          "default": 0,
          "description": "Days to keep process/checkpoint history before it's pruned on the next window reload. 0 or a negative number keeps everything forever (the default, unchanged from prior versions). WARNING: once a process is pruned, Rollback (both single-process and whole-Change) is permanently unavailable for it — pruning is not itself reversible."
        },
        "openspec-ui.staleTaskThresholdDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "description": "Days a pending task can sit untouched (per git blame on tasks.md) before the Change Timeline view flags it as stale."
        },
        "openspec-ui.followSelectionInChangeGraph": {
          "type": "boolean",
          "default": false,
          "description": "When on, selecting a change in Changes or Archive reveals it in the Change Graph automatically. Off by default: the graph shows only changes that state a relation (follows/supersedes/blocked_by), so for most changes there is nothing to reveal — use \"OpenSpec Workbench: Reveal in Change Graph\" on demand instead."
        },
        "openspec-ui.checks": {
          "type": "object",
          "default": {},
          "description": "Names which npm script each check (\"typecheck\", \"test\", \"lint\") runs when invoked from the editor. Unset, the extension prefers an \"osui-<name>\" script when this workspace's package.json declares one, then falls back to \"<name>\"; a workspace declaring neither is offered no command for that check at all, rather than one that fails.",
          "properties": {
            "typecheck": { "type": "string", "description": "npm script to run for the Typecheck command." },
            "test": { "type": "string", "description": "npm script to run for the Run Tests command." },
            "lint": { "type": "string", "description": "npm script to run for the Run Lint command." }
          },
          "additionalProperties": false
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "openspec/templates/*/template.json",
        "url": "./schemas/template.schema.json"
      },
      {
        "fileMatch": "openspec/agent-harness.json",
        "url": "./schemas/agent-harness.schema.json"
      },
      {
        "fileMatch": "openspec/changes/*/harness.json",
        "url": "./schemas/change-harness.schema.json"
      }
    ]
  },
  "dependencies": {
    "@openspec-ui/core": "*",
    "@openspec-ui/webui": "*",
    "@openspec-ui/server": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0",
    "@types/mocha": "^10.0.10",
    "glob": "^13.0.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^6.15.0",
